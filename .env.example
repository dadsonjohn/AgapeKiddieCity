SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional but recommended: long random string used to sign login cookies.
# If omitted, the server falls back to SUPABASE_SECRET_KEY.
SESSION_SECRET=replace-with-a-long-random-string

# Only needed for "npm run setup" (applying supabase/schema.sql from the terminal).
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:<password>@<host>:5432/postgres
